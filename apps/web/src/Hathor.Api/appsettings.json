{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.Extensions.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hathor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Logging": {
    "ConnectionString": "Host=localhost;Port=5432;Database=myhomelab;Username=postgres",
    "Password": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "dev-only-key-replace-via-JWT_KEY-env-in-prod-0123456789abcdef",
    "Issuer": "hathor",
    "Audience": "hathor-clients"
  },
  "Database": {
    "Provider": "postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=hathor;Username=postgres;Password=postgres",
    "StorageRoot": "data"
  },
  "Library": {
    "SongsPath": "",
    "PodcastsPath": ""
  },
  "Discovery": {
    "LlmEnabled": true,
    "Endpoint": "http://localhost:1234/v1",
    "Model": "qwen3.5-4b-uncensored",
    "LlmTimeoutSec": 30,
    "LlmMaxTokens": 1000
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ApiInfo": {
    "Version": "1.0.0"
  }
}
