# Hathor web — local dev overrides (copy to .env, never commit).
# .env is gitignored (apps/web/.gitignore). Fill with LOCAL dev-only values.
JWT_KEY=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_BYTES
LOCALDB_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
# Optional shared lab Postgres for the Error/Fatal logs sink (empty = sink no-op).
LAB_DB_PASSWORD=
HATHOR_TEST_PG=Host=localhost;Port=5432;Username=postgres;Database=postgres
