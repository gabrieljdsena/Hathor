# Secrets — never commit
.env
appsettings.Secrets.json
*.pfx
*.pem
CA.pem

# Databases / local media (anchored: a bare data/ would swallow the
# Android app's data package — see apps/mobile/.../data/)
/data/
/logs/
apps/web/data/
apps/web/logs/
apps/web/src/Hathor.Api/data/
apps/web/src/Hathor.Api/logs/
*.db
*.db-shm
*.db-wal
*.db-journal
hathor.log

# Python (desktop)
__pycache__/
dist/
build/
ffmpeg/
tools/
**/tools/ffmpeg.exe

# Node (desktop ui + web frontend)
node_modules/
frontend/hathor-web/dist/
frontend/hathor-web/shots/
frontend/hathor-web/test-results/
frontend/hathor-web/playwright-report/

# .NET (web)
bin/
obj/
.vs/
*.user

# Deploy outputs (compiled publish + copied SPA — rebuilt by scripts/build.ps1)
artifacts/
**/wwwroot/

# Android (apps/mobile) — never commit secrets or build outputs
local.properties
*.jks
*.keystore
*.p12
*.pfx
*.apk
*.aab
.gradle/
.idea/
build/
**/build/
captures/
